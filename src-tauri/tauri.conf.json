{
  "build": {
    "beforeDevCommand": "yarn start --port 4200",
    "beforeBuildCommand": "yarn prod",
    "devPath": "http://localhost:4200",
    "distDir": "../dist/automation_client",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "automation_client",
    "version": "0.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "show": true,
        "create": true
      }
    },
    "bundle": {
      "active": true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.automationui.dev",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "label": "main",
        "title": "Automation Client",
        "url": "index.html",
        "width": 800,
        "height": 600
      }  
    ]
  }
}
